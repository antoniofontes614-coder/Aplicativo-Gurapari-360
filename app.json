{
  "expo": {
    "name": "GUARAPARI 360°",
    "slug": "guarapari-360",
    "version": "1.0.0",
    "scheme": "guarapari360",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-location"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.guarapari360.app",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.guarapari360.app",
      "buildNumber": "1"
    }
  }
}
